# URL base del backend (sin barra final). Obligatorio coherente con donde corre la API.
# En el mismo PC:
VITE_API_URL=http://127.0.0.1:8000
# Desde movil en la misma Wi-Fi (sustituye por la IP LAN de tu ordenador, ver ipconfig):
# VITE_API_URL=http://192.168.0.161:8000

# Opcional — sección contacto
# VITE_CONTACT_EMAIL=tu-correo@ejemplo.com
